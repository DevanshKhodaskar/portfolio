{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "remix vite:build",
  "outputDirectory": "build/client",
  "functions": {
    "api/index.js": {
      "includeFiles": "build/server/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
